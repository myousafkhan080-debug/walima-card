        const svgNS = 'http://www.w3.org/2000/svg';
        const threadColors = ['#FAF6EF', '#E6D9C3', '#FFFFFF', '#D8C7AC', '#F7F1E7'];
        const count = 72;

        for (let i = 0; i < count; i++) {
          const norm = (i / (count - 1)) * 2 - 1;
          const topX = norm * 10;
          const bottomX = norm * 32;
          const bottomY = 188 + (1 - Math.abs(norm)) * 6;
          const ctrlX = norm * 17;
          const ctrlY = 132;

          const strand = document.createElementNS(svgNS, 'path');
          strand.setAttribute('d', `M ${topX.toFixed(2)} 76 Q ${ctrlX.toFixed(2)} ${ctrlY} ${bottomX.toFixed(2)} ${bottomY.toFixed(2)}`);
          strand.setAttribute('fill', 'none');
          strand.setAttribute('stroke', threadColors[i % threadColors.length]);
          strand.setAttribute('stroke-width', i % 3 === 0 ? '0.85' : '0.65');
          strand.setAttribute('opacity', i % 2 === 0 ? '0.9' : '0.74');
