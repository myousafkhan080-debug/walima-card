      /* 5. Web Audio API: Gentle Silk-Rustle & Pentatonic Santoor/Harp Music */
      let audioCtx = null;
      let masterGain = null;
      let ambientLoopTimer = null;
      let soundEnabled = false;

      function updateSpeakerUI(on) {
        const iconOn = document.getElementById('icon-sound-on');
        const iconOff = document.getElementById('icon-sound-off');
        if (iconOn) iconOn.classList.toggle('hidden', !on);
        if (iconOff) iconOff.classList.toggle('hidden', on);
      }

      function initAudioContext() {
        const Ctx = window.AudioContext || window.webkitAudioContext;
        if (!Ctx) return null;
        if (!audioCtx) {
          audioCtx = new Ctx();
          masterGain = audioCtx.createGain();
          masterGain.gain.setValueAtTime(0.0001, audioCtx.currentTime);
          masterGain.connect(audioCtx.destination);
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        return audioCtx;
      }

      function playSilkRustleAndSantoorChime() {
        try {
          const ctx = initAudioContext();
          if (!ctx) return;
          const now = ctx.currentTime;

          // Filtered Silk Rustle
          const dur = 0.52;
          const frames = Math.floor(ctx.sampleRate * dur);
          const noiseBuf = ctx.createBuffer(1, frames, ctx.sampleRate);
          const channel = noiseBuf.getChannelData(0);
          for (let i = 0; i < frames; i++) {
            channel[i] = (Math.random() * 2 - 1) * Math.sin((i / frames) * Math.PI);
          }

          const src = ctx.createBufferSource();
          src.buffer = noiseBuf;

          const filter = ctx.createBiquadFilter();
          filter.type = 'bandpass';
          filter.frequency.setValueAtTime(1850, now);
          filter.frequency.exponentialRampToValueAtTime(3400, now + dur);
          filter.Q.setValueAtTime(2.5, now);

          const rustleGain = ctx.createGain();
          rustleGain.gain.setValueAtTime(0.001, now);
          rustleGain.gain.linearRampToValueAtTime(0.09, now + 0.08);
          rustleGain.gain.exponentialRampToValueAtTime(0.0001, now + dur);

          src.connect(filter);
          filter.connect(rustleGain);
          rustleGain.connect(ctx.destination);
          src.start(now);

          // Warm Pentatonic Santoor Chime Arpeggio
          [587.33, 659.25, 783.99, 987.77, 1174.66].forEach((freq, idx) => {
            const osc = ctx.createOscillator();
            const g = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(freq, now + idx * 0.08);
            g.gain.setValueAtTime(0.0001, now + idx * 0.08);
            g.gain.exponentialRampToValueAtTime(0.05, now + idx * 0.08 + 0.035);
            g.gain.exponentialRampToValueAtTime(0.0001, now + idx * 0.08 + 2.1);
            osc.connect(g);
            g.connect(ctx.destination);
            osc.start(now + idx * 0.08);
            osc.stop(now + idx * 0.08 + 2.2);
          });
        } catch (e) {
          // Ignore if blocked prior to gesture
        }
      }

      function pluckPentatonicSantoorNote() {
        if (!audioCtx || !masterGain || !soundEnabled) return;
        const now = audioCtx.currentTime;
        const pentatonicNotes = [293.66, 329.63, 392.0, 440.0, 523.25, 587.33, 659.25, 783.99];
        const freq = pentatonicNotes[Math.floor(Math.random() * pentatonicNotes.length)];

        const fundamental = audioCtx.createOscillator();
        const harmonic = audioCtx.createOscillator();
        const env = audioCtx.createGain();

        fundamental.type = 'sine';
        fundamental.frequency.setValueAtTime(freq, now);

        harmonic.type = 'triangle';
        harmonic.frequency.setValueAtTime(freq * 2, now);

        env.gain.setValueAtTime(0.0001, now);
        env.gain.exponentialRampToValueAtTime(0.045, now + 0.05);
        env.gain.exponentialRampToValueAtTime(0.0001, now + 3.0);

        fundamental.connect(env);
        harmonic.connect(env);
        env.connect(masterGain);

        fundamental.start(now);
        harmonic.start(now);
        fundamental.stop(now + 3.1);
        harmonic.stop(now + 3.1);
      }

      function startAmbientMusic() {
        try {
          const ctx = initAudioContext();
          if (!ctx || !masterGain) return;

          if (!ambientLoopTimer) {
            const lowpass = ctx.createBiquadFilter();
            lowpass.type = 'lowpass';
            lowpass.frequency.setValueAtTime(440, ctx.currentTime);
            lowpass.connect(masterGain);

            [146.83, 220.0].forEach((droneFreq) => {
              const osc = ctx.createOscillator();
              const g = ctx.createGain();
              osc.type = 'sine';
              osc.frequency.setValueAtTime(droneFreq, ctx.currentTime);
              g.gain.setValueAtTime(0.016, ctx.currentTime);
              osc.connect(g);
              g.connect(lowpass);
              osc.start();
            });

            ambientLoopTimer = setInterval(pluckPentatonicSantoorNote, 2300);
          }

          masterGain.gain.cancelScheduledValues(ctx.currentTime);
          masterGain.gain.exponentialRampToValueAtTime(0.48, ctx.currentTime + 0.8);
          soundEnabled = true;
          updateSpeakerUI(true);
          pluckPentatonicSantoorNote();
        } catch (err) {
          console.error('Ambient audio error:', err);
        }
      }

      function stopAmbientMusic() {
        if (audioCtx && masterGain) {
          masterGain.gain.cancelScheduledValues(audioCtx.currentTime);
          masterGain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.4);
        }
        soundEnabled = false;
        updateSpeakerUI(false);
      }

      const soundToggleBtn = document.getElementById('sound-toggle-btn');
      if (soundToggleBtn) {
        soundToggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (soundEnabled) {
            stopAmbientMusic();
          } else {
            startAmbientMusic();
          }
        });
      }

      /* 6. Golden Sparkle Particles & Drifting Blush/Gold/Cream Oval Petals */
      const sparkleCanvas = document.getElementById('sparkleCanvas');
      const sparkleCtx = sparkleCanvas ? sparkleCanvas.getContext('2d') : null;
      let goldSparkles = [];

      function resizeSparkles() {
        if (!sparkleCanvas) return;
        sparkleCanvas.width = window.innerWidth;
        sparkleCanvas.height = window.innerHeight;
      }

      function spawnGoldSparkles(cx, cy, count, velocityMult) {
        const goldColors = ['#FFF6D6', '#E6C579', '#C59F52', '#FFFFFF'];
        for (let i = 0; i < count; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = (Math.random() * 2.4 + 0.6) * (velocityMult || 1);
          goldSparkles.push({
            x: cx + (Math.random() - 0.5) * 34,
            y: cy + (Math.random() - 0.5) * 26,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed - 0.3,
            r: Math.random() * 2.5 + 1.4,
            alpha: 1,
            decay: Math.random() * 0.02 + 0.015,
            color: goldColors[i % goldColors.length]
          });
        }
      }

      function animateSparkles() {
        if (sparkleCtx && sparkleCanvas) {
          sparkleCtx.clearRect(0, 0, sparkleCanvas.width, sparkleCanvas.height);
          for (let i = goldSparkles.length - 1; i >= 0; i--) {
            const p = goldSparkles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.03;
            p.alpha -= p.decay;

            if (p.alpha <= 0) {
              goldSparkles.splice(i, 1);
              continue;
            }

            sparkleCtx.save();
            sparkleCtx.globalAlpha = Math.max(0, p.alpha);
            sparkleCtx.fillStyle = p.color;
            sparkleCtx.shadowBlur = 8;
            sparkleCtx.shadowColor = '#E6C579';

            sparkleCtx.beginPath();
            sparkleCtx.moveTo(p.x, p.y - p.r * 1.6);
            sparkleCtx.lineTo(p.x + p.r * 0.45, p.y - p.r * 0.45);
            sparkleCtx.lineTo(p.x + p.r * 1.6, p.y);
            sparkleCtx.lineTo(p.x + p.r * 0.45, p.y + p.r * 0.45);
            sparkleCtx.lineTo(p.x, p.y + p.r * 1.6);
            sparkleCtx.lineTo(p.x - p.r * 0.45, p.y + p.r * 0.45);
            sparkleCtx.lineTo(p.x - p.r * 1.6, p.y);
            sparkleCtx.lineTo(p.x - p.r * 0.45, p.y - p.r * 0.45);
            sparkleCtx.closePath();
            sparkleCtx.fill();
            sparkleCtx.restore();
          }
        }
        requestAnimationFrame(animateSparkles);
      }

      /* Drifting Oval Confetti Petals (#DFACA3 Blush Rose, #E6C579 Warm Gold, #EFE0C6 Soft Cream) */
      const petalCanvas = document.getElementById('confetti-petals-canvas');
      const petalCtx = petalCanvas ? petalCanvas.getContext('2d') : null;
      let ovalPetals = [];

      function resizePetals() {
        if (!petalCanvas) return;
        petalCanvas.width = window.innerWidth;
        petalCanvas.height = window.innerHeight;
      }

      function initOvalPetals(count) {
        if (!petalCanvas) return;
        const colors = [
          'rgba(223, 172, 163, 0.58)',
          'rgba(230, 197, 121, 0.60)',
          'rgba(239, 224, 198, 0.54)'
        ];
        ovalPetals = [];
        for (let i = 0; i < count; i++) {
          ovalPetals.push({
            x: Math.random() * petalCanvas.width,
            y: Math.random() * petalCanvas.height,
            rx: Math.random() * 1.4 + 4.8,
            ry: Math.random() * 0.9 + 2.6,
            vy: Math.random() * 0.45 + 0.25,
            vx: (Math.random() - 0.5) * 0.28,
            rot: Math.random() * Math.PI * 2,
            rotSpd: (Math.random() - 0.5) * 0.02,
            phase: Math.random() * Math.PI * 2,
            color: colors[i % colors.length]
          });
        }
      }

      function burstCelebrationPetals(cx, cy) {
        if (!petalCanvas) return;
        const burstColors = [
          'rgba(223, 172, 163, 0.85)',
          'rgba(230, 197, 121, 0.88)',
          'rgba(239, 224, 198, 0.82)'
        ];
        for (let i = 0; i < 24; i++) {
          ovalPetals.push({
            x: cx + (Math.random() - 0.5) * 110,
            y: cy + (Math.random() - 0.5) * 80,
            rx: Math.random() * 1.4 + 4.8,
            ry: Math.random() * 0.9 + 2.6,
            vy: Math.random() * 0.85 + 0.35,
            vx: (Math.random() - 0.5) * 2.1,
            rot: Math.random() * Math.PI * 2,
            rotSpd: (Math.random() - 0.5) * 0.04,
            phase: Math.random() * Math.PI * 2,
            color: burstColors[i % burstColors.length],
            ephemeral: true
          });
        }
      }

      function renderOvalPetals() {
        if (petalCtx && petalCanvas) {
          petalCtx.clearRect(0, 0, petalCanvas.width, petalCanvas.height);
          for (let i = ovalPetals.length - 1; i >= 0; i--) {
            const p = ovalPetals[i];
            p.phase += 0.015;
            p.y += p.vy;
            p.x += p.vx + Math.sin(p.phase) * 0.35;
            p.rot += p.rotSpd;

            if (p.y > petalCanvas.height + 20) {
              if (p.ephemeral) {
                ovalPetals.splice(i, 1);
                continue;
              }
              p.y = -20;
              p.x = Math.random() * petalCanvas.width;
            }
            if (p.x > petalCanvas.width + 20) p.x = -20;
            if (p.x < -20) p.x = petalCanvas.width + 20;

            petalCtx.save();
            petalCtx.translate(p.x, p.y);
            petalCtx.rotate(p.rot);
            petalCtx.beginPath();
            petalCtx.ellipse(0, 0, p.rx, p.ry, 0, 0, Math.PI * 2);
            petalCtx.fillStyle = p.color;
            petalCtx.fill();
            petalCtx.restore();
          }
        }
        requestAnimationFrame(renderOvalPetals);
      }

      /* 7. 3D Embossed Mughal Double-Door & Pull-Down Silky Tassel ('Dori') Interaction */
      const doorGate = document.getElementById('doorGate');
      const tasselRig = document.getElementById('tasselRig');
      const knotTasselAssembly = document.getElementById('knotTasselAssembly');
      const pretzelKnot = document.getElementById('pretzelKnot');
      const progressRing = document.getElementById('knotProgressRing');
      const dragHitbox = document.getElementById('tasselDragHitbox');
      const bottomCaption = document.getElementById('coverBottomCaption');

      const cordLeftBase = document.getElementById('cordLeftBase');
      const cordLeftGold = document.getElementById('cordLeftGold');
      const cordLeftSilk = document.getElementById('cordLeftSilk');
      const cordRightBase = document.getElementById('cordRightBase');
      const cordRightGold = document.getElementById('cordRightGold');
      const cordRightSilk = document.getElementById('cordRightSilk');

      const RELEASE_THRESHOLD = 45;
      const MAX_PULL_DY = 140;
      const PROGRESS_CIRCUMFERENCE = 226.2;

      let gateW = window.innerWidth;
      let gateH = window.innerHeight;
      let cordAnchorY = gateH * 0.48;
      let pullDX = 0;
      let pullDY = 0;
      let isPulling = false;
      let startPtrX = 0;
      let startPtrY = 0;
      let movedDuringDrag = false;
      let doorsUnlocked = false;
      let springTimer = null;

      function setCordPathD(list, dStr) {
        list.forEach((el) => {
          if (el) el.setAttribute('d', dStr);
        });
      }

      function updateTasselPhysics(dx, dy, retractRatio) {
        if (!tasselRig) return;
        gateW = window.innerWidth;
        gateH = window.innerHeight;
        cordAnchorY = gateH * 0.48;

        tasselRig.setAttribute('viewBox', `0 0 ${gateW} ${gateH}`);

        const midX = gateW * 0.5;
        const knotX = midX + dx;
        const knotY = cordAnchorY + dy;

        if (progressRing) {
          const ratio = Math.max(0, Math.min(1, dy / RELEASE_THRESHOLD));
          progressRing.setAttribute('stroke-dashoffset', String(PROGRESS_CIRCUMFERENCE * (1 - ratio)));
        }

        if (retractRatio > 0) {
          const leftTipX = Math.max(-24, midX * (1 - retractRatio));
          const rightTipX = Math.min(gateW + 24, midX + midX * retractRatio);
          const waveY = cordAnchorY + Math.sin(retractRatio * Math.PI * 1.4) * 22;

          const leftCurve = `M -10 ${cordAnchorY} Q ${leftTipX * 0.5} ${waveY} ${leftTipX} ${cordAnchorY + retractRatio * 14}`;
          const rightCurve = `M ${rightTipX} ${cordAnchorY + retractRatio * 14} Q ${rightTipX + (gateW - rightTipX) * 0.5} ${waveY} ${gateW + 10} ${cordAnchorY}`;

          setCordPathD([cordLeftBase, cordLeftGold, cordLeftSilk], leftCurve);
          setCordPathD([cordRightBase, cordRightGold, cordRightSilk], rightCurve);
        } else {
          const leftCtrlX = knotX * 0.48;
          const leftCtrlY = cordAnchorY + dy * 0.35;
          const rightCtrlX = knotX + (gateW - knotX) * 0.52;
          const rightCtrlY = cordAnchorY + dy * 0.35;

          const leftCurve = `M -10 ${cordAnchorY} Q ${leftCtrlX} ${leftCtrlY} ${knotX} ${knotY}`;
          const rightCurve = `M ${knotX} ${knotY} Q ${rightCtrlX} ${rightCtrlY} ${gateW + 10} ${cordAnchorY}`;

          setCordPathD([cordLeftBase, cordLeftGold, cordLeftSilk], leftCurve);
          setCordPathD([cordRightBase, cordRightGold, cordRightSilk], rightCurve);
        }

        if (knotTasselAssembly) {
          knotTasselAssembly.setAttribute('transform', `translate(${knotX}, ${knotY})`);
        }
      }

      function activateScrollReveals() {
        const items = document.querySelectorAll('.editorial-reveal');
        if ('IntersectionObserver' in window) {
          const obs = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  obs.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.1 }
          );
          items.forEach((item) => obs.observe(item));
        } else {
          items.forEach((item) => item.classList.add('is-visible'));
        }
      }

      function untieAndOpenDoors() {
        if (doorsUnlocked) return;
        doorsUnlocked = true;
        if (springTimer) cancelAnimationFrame(springTimer);

        playSilkRustleAndSantoorChime();
        startAmbientMusic();

        const midX = gateW * 0.5;
        const currentKnotY = cordAnchorY + pullDY;
        spawnGoldSparkles(midX, currentKnotY, 44, 1.45);
        burstCelebrationPetals(midX, currentKnotY);

        if (bottomCaption) bottomCaption.style.opacity = '0';

        const startT = performance.now();
        const untieMs = 380;

        function stepUntie(now) {
          const progress = Math.min(1, (now - startT) / untieMs);
          const ease = 1 - Math.pow(1 - progress, 3);

          updateTasselPhysics(pullDX * (1 - ease), pullDY + ease * 60, ease);

          if (pretzelKnot) {
            pretzelKnot.style.opacity = String(1 - ease);
            pretzelKnot.setAttribute('transform', `scale(${1 + ease * 0.4})`);
          }
          if (knotTasselAssembly) {
            knotTasselAssembly.style.opacity = String(Math.max(0, 1 - progress * 1.35));
          }
          if (progress > 0.3 && doorGate) {
            doorGate.classList.add('seam-glow');
          }

          if (progress < 1) {
            requestAnimationFrame(stepUntie);
          } else {
            if (doorGate) {
              doorGate.classList.add('doors-open');
            }
            document.body.classList.remove('gate-locked');
            activateScrollReveals();

            setTimeout(() => {
              if (doorGate) doorGate.classList.add('gate-fading');
            }, 900);

            setTimeout(() => {
              if (doorGate) doorGate.style.display = 'none';
            }, 1550);
          }
        }

        requestAnimationFrame(stepUntie);
      }

      function snapBackElastic() {
        if (springTimer) cancelAnimationFrame(springTimer);
        let vy = 0;
        let vx = 0;
        const k = 0.16;
        const damp = 0.72;

        function tick() {
          vy = (vy - pullDY * k) * damp;
          vx = (vx - pullDX * k) * damp;
          pullDY += vy;
          pullDX += vx;
          updateTasselPhysics(pullDX, pullDY, 0);

          if (Math.abs(pullDY) < 0.3 && Math.abs(vy) < 0.3) {
            pullDY = 0;
            pullDX = 0;
            updateTasselPhysics(0, 0, 0);
            return;
          }
          springTimer = requestAnimationFrame(tick);
        }

        springTimer = requestAnimationFrame(tick);
      }

      function animateAutoPullAndOpen() {
        if (doorsUnlocked) return;
        const fromY = pullDY;
        const toY = 125;
        const t0 = performance.now();
        const duration = 420;

        function stepPull(now) {
          const p = Math.min(1, (now - t0) / duration);
          const ease = p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2;
          pullDY = fromY + (toY - fromY) * ease;
          updateTasselPhysics(0, pullDY, 0);

          if (Math.random() < 0.5) {
            spawnGoldSparkles(gateW * 0.5, cordAnchorY + pullDY, 2, 0.8);
          }

          if (p < 1) {
            requestAnimationFrame(stepPull);
          } else {
            untieAndOpenDoors();
          }
        }

        requestAnimationFrame(stepPull);
      }

      if (dragHitbox) {
        dragHitbox.addEventListener('pointerdown', (e) => {
          if (doorsUnlocked) return;
          isPulling = true;
          movedDuringDrag = false;
          startPtrX = e.clientX;
          startPtrY = e.clientY;
          if (springTimer) cancelAnimationFrame(springTimer);
          if (knotTasselAssembly) knotTasselAssembly.classList.add('tassel-dragging');
          dragHitbox.setPointerCapture(e.pointerId);
          spawnGoldSparkles(gateW * 0.5, cordAnchorY, 8, 0.85);
        });

        dragHitbox.addEventListener('pointermove', (e) => {
          if (!isPulling || doorsUnlocked) return;
          const dx = e.clientX - startPtrX;
          const dy = e.clientY - startPtrY;

          if (Math.abs(dy) > 5 || Math.abs(dx) > 5) {
            movedDuringDrag = true;
          }

          pullDY = Math.max(-8, Math.min(MAX_PULL_DY, dy * 0.95));
          pullDX = Math.max(-26, Math.min(26, dx * 0.22));
          updateTasselPhysics(pullDX, pullDY, 0);

          if (pullDY > 8 && Math.random() < 0.5) {
            spawnGoldSparkles(gateW * 0.5 + pullDX, cordAnchorY + pullDY, 2, 0.75);
          }
        });

        const endPointerGesture = () => {
          if (!isPulling) return;
          isPulling = false;
          if (knotTasselAssembly) knotTasselAssembly.classList.remove('tassel-dragging');

          if (!movedDuringDrag) {
            animateAutoPullAndOpen();
          } else if (pullDY >= RELEASE_THRESHOLD) {
            untieAndOpenDoors();
          } else {
            snapBackElastic();
          }
        };

        dragHitbox.addEventListener('pointerup', endPointerGesture);
        dragHitbox.addEventListener('pointercancel', endPointerGesture);
      }

      /* Tapping/Clicking Anywhere on the Doors Opens Smoothly */
      if (doorGate) {
        doorGate.addEventListener('click', (e) => {
          if (doorsUnlocked || isPulling || movedDuringDrag) return;
          if (e.target === dragHitbox) return;
          animateAutoPullAndOpen();
        });
      }

      /* Replay Opening Door Button in Footer */
      const replayDoorBtn = document.getElementById('replay-door-btn');
      if (replayDoorBtn) {
        replayDoorBtn.addEventListener('click', () => {
          if (!doorGate) return;
          window.scrollTo({ top: 0, behavior: 'smooth' });
          doorsUnlocked = false;
          pullDX = 0;
          pullDY = 0;

          if (pretzelKnot) {
            pretzelKnot.style.opacity = '1';
            pretzelKnot.setAttribute('transform', 'scale(1)');
          }
          if (knotTasselAssembly) {
            knotTasselAssembly.style.opacity = '1';
          }
          if (bottomCaption) {
            bottomCaption.style.opacity = '1';
          }

          doorGate.style.display = 'flex';
          doorGate.classList.remove('gate-fading', 'seam-glow');
          void doorGate.offsetWidth;
          doorGate.classList.remove('doors-open');
          document.body.classList.add('gate-locked');
          resizeSparkles();
          updateTasselPhysics(0, 0, 0);
        });
      }

      /* 8. Live Countdown to Walima: Monday, December 14, 2026 at 18:00:00 PKT (+05:00) */
      const walimaEpoch = new Date('2026-12-14T18:00:00+05:00').getTime();

      function updateCountdown() {
        const remaining = walimaEpoch - Date.now();
        const dEl = document.getElementById('cd-days');
        const hEl = document.getElementById('cd-hours');
        const mEl = document.getElementById('cd-minutes');
        const sEl = document.getElementById('cd-seconds');
        if (!dEl || !hEl || !mEl || !sEl) return;

        if (remaining <= 0) {
          dEl.textContent = '00';
          hEl.textContent = '00';
          mEl.textContent = '00';
          sEl.textContent = '00';
          return;
        }

        const days = Math.floor(remaining / (1000 * 60 * 60 * 24));
        const hours = Math.floor((remaining / (1000 * 60 * 60)) % 24);
        const mins = Math.floor((remaining / (1000 * 60)) % 60);
        const secs = Math.floor((remaining / 1000) % 60);

        dEl.textContent = String(days).padStart(2, '0');
        hEl.textContent = String(hours).padStart(2, '0');
        mEl.textContent = String(mins).padStart(2, '0');
        sEl.textContent = String(secs).padStart(2, '0');
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);

      /* 9. Valid .ICS Calendar File Download ('Save Date') for Walima */
      const icsEvents = {
        walima: {
          filename: 'Hamza-Amna-Walima.ics',
          summary: 'Hamza & Amna — Walima Reception',
          location: 'Meridian Marquee, Sham Nagar, Lahore, Pakistan',
          description: 'Walima Invitation: Hamza (Son of Mr. & Mrs. Zahid) & Amna (Daughter of Mr. & Mrs. Amin) — Dawat-e-Walima at Meridian Marquee, Sham Nagar, Lahore.',
          dtStart: '20261214T180000',
          dtEnd: '20261214T220000'
        }
      };

      window.downloadEventICS = function (key) {
        try {
          const ev = icsEvents[key];
          if (!ev) return;

          const icsPayload = [
            'BEGIN:VCALENDAR',
            'VERSION:2.0',
            'PRODID:-//Hamza & Amna//Sunset Courtyard Walima//EN',
            'CALSCALE:GREGORIAN',
            'BEGIN:VEVENT',
            `UID:${key}-hamza-amna-2026@sunsetcourtyard`,
            'DTSTAMP:20261123T163000Z',
            `DTSTART;TZID=Asia/Karachi:${ev.dtStart}`,
            `DTEND;TZID=Asia/Karachi:${ev.dtEnd}`,
            `SUMMARY:${ev.summary}`,
            `LOCATION:${ev.location}`,
            `DESCRIPTION:${ev.description}`,
            'END:VEVENT',
            'END:VCALENDAR'
          ].join('\r\n');

          const blob = new Blob([icsPayload], { type: 'text/calendar;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = url;
          link.download = ev.filename;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
          URL.revokeObjectURL(url);

          showToast(i18nDict[activeLang].toastSaved);
        } catch (err) {
          console.error('Calendar download error:', err);
        }
      };

      /* 10. Copy Walima Invitation Text to Clipboard */
      const plainInvitationText = `بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيم
WALIMA INVITATION

HAMZA
(Son of Mr. & Mrs. Zahid)
&
AMNA
(Daughter of Mr. & Mrs. Amin)

cordially invite you to grace their Dawat-e-Walima in Lahore, Pakistan:

WALIMA RECEPTION
Monday, 14 December 2026 • 6:00 PM
Meridian Marquee, Sham Nagar, Lahore, Pakistan
https://www.google.com/maps/search/?api=1&query=Meridian+Marquee+Sham+Nagar+Lahore+Pakistan

"And We created you in pairs" — Surah An-Naba 78:8
Warmly awaited by the families of Mr. & Mrs. Zahid and Mr. & Mrs. Amin.`;

      const copyInviteBtn = document.getElementById('copy-invite-btn');
      if (copyInviteBtn) {
        copyInviteBtn.addEventListener('click', () => {
          try {
            const ta = document.createElement('textarea');
            ta.value = plainInvitationText;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            ta.setSelectionRange(0, 99999);
            const copied = document.execCommand('copy');
            document.body.removeChild(ta);
            if (copied) {
              showToast(i18nDict[activeLang].toastCopied);
            }
          } catch (err) {
            console.error('Copy failed:', err);
          }
        });
      }

      /* 11. Initialize Canvases & Physics on Load & Resize */
      window.addEventListener('resize', () => {
        resizePetals();
        resizeSparkles();
        initOvalPetals(window.innerWidth < 640 ? 18 : 26);
        if (!doorsUnlocked) {
          updateTasselPhysics(pullDX, pullDY, 0);
        }
      });

      window.addEventListener('load', () => {
        resizePetals();
        resizeSparkles();
        initOvalPetals(window.innerWidth < 640 ? 18 : 26);
        renderOvalPetals();
        animateSparkles();
        updateTasselPhysics(0, 0, 0);
      });
    })();
  </script>
</body>
