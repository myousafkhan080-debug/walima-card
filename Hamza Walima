<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hamza &amp; Amna — Walima Invitation</title>

  <!-- Google Fonts: Cormorant Garamond, Plus Jakarta Sans, Amiri, Noto Nastaliq Urdu -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Noto+Nastaliq+Urdu:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            courtyard: {
              cream: '#F7F1E7',
              sandstone: '#EDE1CE',
              ivory: '#FAF6EF',
              border: '#DFD3C3',
            },
            wine: {
              DEFAULT: '#5A1721',
              deep: '#430F17',
            },
            gold: {
              antique: '#C59F52',
              honey: '#E6C579',
              pill: '#F3DC9C',
              bronze: '#9E7B2F',
            },
            taupe: {
              mauve: '#8B736E',
              hover: '#76605B',
            },
            charcoal: {
              warm: '#3A2B28',
              soft: '#6E5A56',
            }
          },
          fontFamily: {
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            arabic: ['"Amiri"', 'serif'],
            urdu: ['"Noto Nastaliq Urdu"', '"Amiri"', 'serif'],
          }
        }
      }
    };
  </script>

  <style>
    :root {
      --bg-cream: #F7F1E7;
      --bg-sandstone: #EDE1CE;
      --wine-primary: #5A1721;
      --gold-antique: #C59F52;
      --gold-bronze: #9E7B2F;
      --gold-honey: #E6C579;
      --mauve-taupe: #8B736E;
      --charcoal-warm: #3A2B28;
    }

    html, body {
      max-width: 100%;
      overflow-x: hidden;
      background-color: #F7F1E7;
      color: var(--charcoal-warm);
      font-family: 'Cormorant Garamond', Georgia, serif;
      -webkit-tap-highlight-color: transparent;
    }

    body.gate-locked {
      overflow: hidden;
      height: 100dvh;
    }

    /* ===================================================================== */
    /* 1. FULL-SCREEN HIGH-RES BADSHAHI MASJID, LAHORE GOLDEN SUNSET LAYER   */
    /* ===================================================================== */
    #badshahi-backdrop {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      overflow: hidden;
      pointer-events: none;
      background: linear-gradient(180deg, #F7F1E7 0%, #EDE1CE 50%, #5A1721 100%);
    }

    @keyframes slowArchitecturalZoom {
      0% { transform: scale(1); }
      50% { transform: scale(1.06); }
      100% { transform: scale(1); }
    }

    .badshahi-photo {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 36%;
      animation: slowArchitecturalZoom 25s ease-in-out infinite;
      will-change: transform;
    }

    #sunset-atmospheric-wash {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        180deg,
        rgba(247, 241, 231, 0.76) 0%,
        rgba(237, 225, 206, 0.66) 48%,
        rgba(90, 23, 33, 0.62) 100%
      );
    }

    /* ===================================================================== */
    /* 2. OPENING 3D EMBOSSED MUGHAL DOUBLE-DOOR & PULL-DOWN TASSEL GATE     */
    /* ===================================================================== */
    #doorGate {
      position: fixed;
      inset: 0;
      z-index: 9999;
      perspective: 1800px;
      display: flex;
      overflow: hidden;
      user-select: none;
      touch-action: none;
      background: radial-gradient(circle at 50% 48%, rgba(255, 245, 218, 0.25), rgba(45, 16, 20, 0.55));
      transition: opacity 0.65s ease;
    }

    #doorGate.gate-fading {
      opacity: 0;
      pointer-events: none;
    }

    .embossed-door-leaf {
      position: relative;
      width: 50%;
      height: 100%;
      background: linear-gradient(180deg, #F5EFE6 0%, #EFE6D8 52%, #EAE0D2 100%);
      transform-style: preserve-3d;
      backface-visibility: hidden;
      transition: transform 1.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 1.35s ease;
      overflow: hidden;
    }

    #doorLeft {
      transform-origin: left center;
      box-shadow:
        inset -2px 0 3px rgba(130, 108, 78, 0.35),
        inset -16px 0 30px rgba(164, 144, 116, 0.14);
    }

    #doorRight {
      transform-origin: right center;
      box-shadow:
        inset 1.5px 0 2px rgba(255, 253, 248, 0.95),
        inset 16px 0 30px rgba(164, 144, 116, 0.12);
    }

    #doorGate.doors-open #doorLeft {
      transform: rotateY(-115deg);
      box-shadow: 28px 0 60px rgba(42, 14, 18, 0.42);
    }

    #doorGate.doors-open #doorRight {
      transform: rotateY(115deg);
      box-shadow: -28px 0 60px rgba(42, 14, 18, 0.42);
    }

    /* Warm Golden Light Seam Shining Down Center Crack as Doors Unlock */
    #goldenSeamBeam {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 4px;
      transform: translateX(-50%) scaleX(0);
      background: linear-gradient(180deg, rgba(255, 248, 224, 0.25) 0%, rgba(255, 236, 179, 0.96) 50%, rgba(255, 248, 224, 0.25) 100%);
      box-shadow: 0 0 42px 20px rgba(230, 197, 121, 0.88), 0 0 90px 40px rgba(255, 249, 230, 0.65);
      opacity: 0;
      pointer-events: none;
      z-index: 15;
      transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.6s ease;
    }

    #doorGate.seam-glow #goldenSeamBeam {
      opacity: 1;
      transform: translateX(-50%) scaleX(16);
    }

    @keyframes tasselBreezeSway {
      0%, 100% { transform: rotate(-2.2deg); }
      50% { transform: rotate(2.2deg); }
    }

    #tasselPendulum {
      transform-origin: 0px 10px;
      animation: tasselBreezeSway 3.6s ease-in-out infinite;
    }

    .tassel-dragging #tasselPendulum {
      animation: none;
    }

    @keyframes gentlePullArrow {
      0%, 100% { transform: translateY(0); opacity: 0.75; }
      50% { transform: translateY(4px); opacity: 1; }
    }

    .pull-cue-arrow {
      animation: gentlePullArrow 1.8s ease-in-out infinite;
    }

    /* ===================================================================== */
    /* 3. SUNSET COURTYARD FROSTED GLASSMORPHISM & EDITORIAL TYPOGRAPHY      */
    /* ===================================================================== */
    .courtyard-cream-card {
      background: rgba(250, 246, 239, 0.86);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid #DFD3C3;
      border-radius: 22px;
      box-shadow: 0 18px 44px -14px rgba(58, 43, 40, 0.16);
      transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease, border-color 0.35s ease;
    }

    .courtyard-cream-card:hover {
      transform: translateY(-2px);
      border-color: rgba(197, 159, 82, 0.72);
      box-shadow: 0 22px 50px -14px rgba(90, 23, 33, 0.2);
    }

    .courtyard-sandstone-band {
      background: rgba(237, 225, 206, 0.84);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid #DFD3C3;
      border-radius: 24px;
      box-shadow: 0 18px 44px -14px rgba(58, 43, 40, 0.15);
    }

    /* Arch-Topped Countdown Pillar */
    .countdown-arch-pillar {
      background: rgba(250, 246, 239, 0.86);
      border: 1px solid #DFD3C3;
      border-radius: 999px 999px 18px 18px;
      box-shadow: 0 10px 24px -10px rgba(90, 23, 33, 0.14);
    }

    .courtyard-wine-footer {
      background: rgba(90, 23, 33, 0.92);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      color: #F7F1E7;
      border-top: 1px solid rgba(230, 197, 121, 0.35);
    }

    /* Gold Hairline Section Eyebrow */
    .noora-eyebrow {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--gold-bronze);
    }

    .noora-eyebrow::before,
    .noora-eyebrow::after {
      content: '';
      display: inline-block;
      width: 32px;
      height: 1px;
      background-color: var(--gold-antique);
      flex-shrink: 0;
    }

    .noora-eyebrow-light {
      color: var(--gold-honey);
    }

    .noora-eyebrow-light::before,
    .noora-eyebrow-light::after {
      background-color: var(--gold-honey);
      opacity: 0.72;
    }

    /* Urdu Language Mode Support */
    body.urdu-mode .bilingual {
      font-family: 'Noto Nastaliq Urdu', 'Amiri', serif !important;
      line-height: 2.25 !important;
      letter-spacing: 0 !important;
      text-transform: none !important;
    }

    body.urdu-mode .noora-eyebrow {
      font-family: 'Noto Nastaliq Urdu', 'Amiri', serif !important;
      font-size: 0.95rem !important;
      letter-spacing: 0 !important;
      text-transform: none !important;
      line-height: 2.05 !important;
    }

    /* Smooth Scroll Reveal */
    .editorial-reveal {
      opacity: 0;
      transform: translateY(18px);
      transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .editorial-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }
  </style>
</head>

<body class="gate-locked text-charcoal-warm antialiased selection:bg-wine selection:text-courtyard-cream">

